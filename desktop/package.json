{
  "name": "pemdes-pandanwangi-desktop",
  "version": "1.0.0",
  "description": "Aplikasi Pemdes Pandanwangi untuk komputer (Windows)",
  "main": "main.js",
  "author": "Pemerintah Desa Pandanwangi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.desa.pandanwangi.pemdes",
    "productName": "Pemdes Pandanwangi",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "offline.html", "icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "Pemdes-Pandanwangi-Pasang-${version}.${ext}"
    },
    "portable": { "artifactName": "Pemdes-Pandanwangi-Portabel-${version}.${ext}" }
  }
}
